{
  "buildCommand": "pnpm db:migrate && pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api|explanations|data|assets|landing|favicon|apple-touch-icon|og-image|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ]
}
