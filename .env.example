# libSQL connection. For local dev use a file path; for Turso use libsql://
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# 'true' on Vercel / HTTPS; 'false' for plain-http local dev
SESSION_COOKIE_SECURE=false

# Shared invite code for self-registration at /register. If unset/empty, signup
# is disabled and users must be created with `pnpm user:add`. Share this code
# only with people you want to be able to create an account.
SIGNUP_CODE=

# "Pokračovat přes Google/Seznam" (OAuth 2.0). A provider is enabled only when both
# its ID and secret are set; first sign-in creates the account (no SIGNUP_CODE needed).
# Register these redirect URIs with the provider:
#   <APP_URL>/api/auth/oauth/google/callback
#   <APP_URL>/api/auth/oauth/seznam/callback
# Google: https://console.cloud.google.com/apis/credentials (Web application client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seznam: https://vyvojari.seznam.cz/oauth/admin
SEZNAM_CLIENT_ID=
SEZNAM_CLIENT_SECRET=

# Public origin used to build OAuth redirect URIs, e.g. https://vmp.example.cz
# (no trailing slash). Set it in production and behind a reverse proxy. When empty,
# the request origin is used (http://localhost:5400 in dev via the Vite proxy).
APP_URL=

# Port the Hono server binds to (Docker / local)
PORT=3001

# Port the Vite dev server listens on (frontend). Proxies /api to PORT above.
VITE_DEV_PORT=5400

# Feedback -> GitHub issues. If unset, the /api/feedback endpoint returns 503.
# Use a fine-grained PAT with "Issues: Write" on this repo only.
GITHUB_FEEDBACK_REPO=davidesner/vmp-m-trainer
GITHUB_FEEDBACK_TOKEN=
