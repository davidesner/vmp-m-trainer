# libSQL connection. For local dev use a file path; for Turso use libsql://
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# 'true' on Vercel / HTTPS; 'false' for plain-http local dev
SESSION_COOKIE_SECURE=false

# Cloudflare Turnstile captcha for self-registration at /register. Both keys
# must be set, otherwise signup is disabled and users must be created with
# `pnpm user:add`. The values below are Cloudflare's test keys: they always
# pass and work on any hostname, so use them for local dev only. Create real
# keys in the Cloudflare dashboard (Turnstile -> Add widget) for production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Port the Hono server binds to (Docker / local)
PORT=3001

# Port the Vite dev server listens on (frontend). Proxies /api to PORT above.
VITE_DEV_PORT=5400

# Feedback -> GitHub issues. If unset, the /api/feedback endpoint returns 503.
# Use a fine-grained PAT with "Issues: Write" on this repo only.
GITHUB_FEEDBACK_REPO=davidesner/vmp-m-trainer
GITHUB_FEEDBACK_TOKEN=
